# ── HUS Gateway Configuration ─────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER deploy .env to production servers —
# set these as environment variables in your deployment platform instead.
#
# All HUS_* env vars map to --long-name CLI flags:
#
#   export HUS_LISTEN=0.0.0.0:3000
#   cargo run -p hus-gateway
#
# is equivalent to:
#
#   cargo run -p hus-gateway -- --listen 0.0.0.0:3000

HUS_LISTEN=0.0.0.0:3000
HUS_NETWORK=https://shellnet.ackinacki.org/graphql
HUS_REGISTRY=0:<registry-address-hex>
HUS_PROVING_KEY_FILE=/path/to/proving-key.bin
HUS_VERIFYING_KEY_FILE=/path/to/verifying-key.bin
HUS_PUBLIC_KEY=<protocol-wallet-public-hex>
HUS_SECRET_KEY=<protocol-wallet-secret-hex>
# HUS_API_KEY=optional-bearer-token
